{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uci-arena.example/schemas/install-component.schema.json",
  "title": "arena_install_component_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "component_id", "component_version", "files"],
  "dependentRequired": {
    "installer_integration": ["workspace_name"]
  },
  "properties": {
    "schema": {"const": "arena_install_component_v1"},
    "schema_version": {"const": 1},
    "component_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "component_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "target_triple": {"type": "string"},
    "display_name": {"type": "string", "minLength": 1},
    "entrypoints": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "default_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "display_name", "input_adapter_id", "root"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "input_adapter_id": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1}
      }
    },
    "manager_integration_api": {
      "$ref": "manager-service-api.schema.json"
    },
    "contract_manifest": {"type": "string", "minLength": 1},
    "configuration_template": {"type": "string", "minLength": 1},
    "workspace_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "installer_integration": {"$ref": "#/$defs/installer_integration"},
    "discovery": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/discovery_entry"}
    },
    "activation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/activation_entry"}
    },
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
      "uniqueItems": true
    },
    "startup": {"type": "object"},
    "data_paths": {"type": "array", "items": {"type": "string"}},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "discovery_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"enum": ["active_root", "entrypoint", "component_path"]},
        "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "path": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "entrypoint"}}},
          "then": {"required": ["entrypoint"]}
        },
        {
          "if": {"properties": {"source": {"const": "component_path"}}},
          "then": {"required": ["path"]}
        }
      ]
    },
    "discovery_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "locator": {"$ref": "#/$defs/discovery_locator"}
      }
    },
    "activation_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_path", "destination_root", "destination_path"],
      "properties": {
        "kind": {"enum": ["opening_book", "syzygy"]},
        "source_path": {"type": "string", "minLength": 1},
        "destination_root": {"const": "knowledge_root"},
        "destination_path": {"type": "string", "minLength": 1}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runtime_component_id", "runtime_entrypoint"],
      "properties": {
        "kind": {"const": "dependency_runtime"},
        "runtime_component_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "runtime_entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
      }
    },
    "dependency_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "component_id", "source", "required"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "component_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "source": {"enum": ["active_root", "entrypoint", "component_path"]},
        "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "path": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "entrypoint"}}},
          "then": {"required": ["entrypoint"]}
        },
        {
          "if": {"properties": {"source": {"const": "component_path"}}},
          "then": {"required": ["path"]}
        }
      ]
    },
    "locator_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "required"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "kind": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "required": {"type": "boolean"},
        "accepted_sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["saved_locator", "install_receipt"]}
        }
      }
    },
    "startup_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "entrypoint", "actions",
        "workspace_argument", "configuration_argument", "result"
      ],
      "properties": {
        "schema": {"const": "arena_provider_startup_control_v1"},
        "schema_version": {"const": 1},
        "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["install", "uninstall"],
          "properties": {
            "install": {
              "type": "array", "minItems": 1, "maxItems": 8,
              "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
            },
            "uninstall": {
              "type": "array", "minItems": 1, "maxItems": 8,
              "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
            }
          }
        },
        "workspace_argument": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flag", "relative_path"],
          "properties": {
            "flag": {"type": "string", "pattern": "^--[A-Za-z0-9._-]+$"},
            "relative_path": {"type": "string", "minLength": 1}
          }
        },
        "configuration_argument": {
          "type": "string", "pattern": "^--[A-Za-z0-9._-]+$"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "envelope", "require_configuration_match_on_install",
            "require_live_on_install"
          ],
          "properties": {
            "envelope": {"enum": ["root", "startup"]},
            "require_configuration_match_on_install": {"type": "boolean"},
            "require_live_on_install": {"type": "boolean"}
          }
        }
      }
    },
    "installer_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "schema_version", "entrypoint", "invocation", "arguments",
        "workspace_name", "configure_when_disabled", "dependency_bindings",
        "locator_bindings"
      ],
      "properties": {
        "schema": {"const": "arena_provider_installer_integration_v1"},
        "schema_version": {"const": 1},
        "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "invocation": {"$ref": "#/$defs/invocation"},
        "arguments": {
          "type": "array",
          "prefixItems": [{"const": "--context"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "workspace_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "workspace_placement": {
          "type": "string",
          "enum": ["workspace_root", "product_data"],
          "default": "workspace_root"
        },
        "configure_when_disabled": {"type": "boolean"},
        "dependency_bindings": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/dependency_binding"}
        },
        "locator_bindings": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/locator_binding"}
        },
        "startup_control": {"$ref": "#/$defs/startup_control"}
      }
    }
  }
}
