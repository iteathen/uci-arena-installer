{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uci-arena.example/schemas/clean-build-result.schema.json",
  "title": "arena_clean_build_result_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "suite_version",
    "target_platform",
    "source_repository",
    "source_commit",
    "clean_tree",
    "build_preset",
    "installer_authority",
    "release_scope",
    "release_classification",
    "artifacts"
  ],
  "properties": {
    "schema": {"const": "arena_clean_build_result_v1"},
    "schema_version": {"const": 1},
    "suite_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "target_platform": {
      "enum": ["windows-x86_64", "linux-x86_64"]
    },
    "source_repository": {"const": "iteathen/uci-arena-installer"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "clean_tree": {"const": true},
    "build_preset": {"enum": ["windows-release", "linux-release"]},
    "installer_authority": {"const": "iteathen/uci-arena-installer"},
    "release_scope": {"enum": ["complete_development", "complete_release"]},
    "release_classification": {"enum": ["unsigned_suite_candidate", "signed_suite_release"]},
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size_bytes", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
